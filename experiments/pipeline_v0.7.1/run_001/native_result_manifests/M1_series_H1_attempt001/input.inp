/BATCH
/CLEAR,START
/FILNAME,elastic
/PREP7
ET,1,PLANE182
KEYOPT,1,1,0
KEYOPT,1,3,3
KEYOPT,1,6,0
R,1,1
TYPE,1
REAL,1
MP,EX,1,1000
MP,PRXY,1,0
MP,EX,2,10000
MP,PRXY,2,0
FINISH
/INPUT,mesh,inp
/PREP7
D,BOTTOM,UY,0
D,TOP,UY,0
D,1,UX,0
/OUTPUT,inventory,txt
ETLIST,ALL
RLIST,ALL
MPLIST,ALL
DLIST,ALL
CHECK
/OUTPUT
FINISH
/SOLU
ANTYPE,STATIC,NEW
NLGEOM,OFF
EQSLV,SPARSE
AUTOTS,OFF
NSUBST,1,1,1
KBC,1
OUTRES,ALL,ALL
OUTPR,ALL,NONE
TIME,0.001
D,TOP,UY,-0.001
SOLVE
TIME,0.002
D,TOP,UY,-0.002
SOLVE
TIME,0.0030000000000000001
D,TOP,UY,-0.0030000000000000001
SOLVE
TIME,0.0040000000000000001
D,TOP,UY,-0.0040000000000000001
SOLVE
TIME,0.0050000000000000001
D,TOP,UY,-0.0050000000000000001
SOLVE
FINISH
SAVE,model,db
/POST1
RSYS,0
ALLSEL,ALL
/OUTPUT,result_sets,txt
SET,LIST
/OUTPUT
SET,LAST
*GET,NSETS,ACTIVE,0,SET,NSET
*GET,NNAT,NODE,0,COUNT
*GET,ENAT,ELEM,0,COUNT
*CFOPEN,curve,csv
*DO,ISTEP,1,5
SET,ISTEP,1
*GET,TNOW,ACTIVE,0,SET,TIME
ETABLE,ERAS
ETABLE,EENG,SENE
ETABLE,ELVOL,VOLU
SSUM
*GET,TENG,SSUM,0,ITEM,EENG
*GET,TVOL,SSUM,0,ITEM,ELVOL
FTOP=0
FBOT=0
UTMIN=1
UTMAX=-1
UBMAX=0
*DO,INODE,1057,1089
*GET,FR,NODE,INODE,RF,FY
FTOP=FTOP+FR
*GET,UV,NODE,INODE,U,Y
UTMIN=MIN(UTMIN,UV)
UTMAX=MAX(UTMAX,UV)
*ENDDO
*DO,INODE,1,33
*GET,FR,NODE,INODE,RF,FY
FBOT=FBOT+FR
*GET,UV,NODE,INODE,U,Y
UBMAX=MAX(UBMAX,ABS(UV))
*ENDDO
*GET,FPIN,NODE,1,RF,FX
*VWRITE,ISTEP,TNOW,UTMIN,UTMAX,UBMAX,FTOP,FBOT,FPIN,TENG,TVOL,NNAT,ENAT
(F8.0,11(',',E24.16))
*ENDDO
*CFCLOS
SET,LAST
*DIM,NIDS,ARRAY,1089
*DIM,NVAL,ARRAY,1089,4
*VFILL,NIDS(1),RAMP,1,1
*VGET,NVAL(1,1),NODE,1,LOC,X
*VGET,NVAL(1,2),NODE,1,LOC,Y
*VGET,NVAL(1,3),NODE,1,U,X
*VGET,NVAL(1,4),NODE,1,U,Y
*CFOPEN,nodes,csv
*VWRITE,NIDS(1),NVAL(1,1),NVAL(1,2),NVAL(1,3),NVAL(1,4)
(F12.0,4(',',E24.16))
*CFCLOS
*DEL,NIDS
*DEL,NVAL
ETABLE,ERAS
*DIM,EIDS,ARRAY,1024
*DIM,EVAL,ARRAY,1024,11
*VFILL,EIDS(1),RAMP,1,1
*VGET,EVAL(1,1),ELEM,1,ATTR,MAT
ETABLE,SXX,S,X
*VGET,EVAL(1,2),ELEM,1,ETAB,SXX
ETABLE,SYY,S,Y
*VGET,EVAL(1,3),ELEM,1,ETAB,SYY
ETABLE,SXY,S,XY
*VGET,EVAL(1,4),ELEM,1,ETAB,SXY
ETABLE,SEQ,S,EQV
*VGET,EVAL(1,5),ELEM,1,ETAB,SEQ
ETABLE,EXX,EPEL,X
*VGET,EVAL(1,6),ELEM,1,ETAB,EXX
ETABLE,EYY,EPEL,Y
*VGET,EVAL(1,7),ELEM,1,ETAB,EYY
ETABLE,GXY,EPEL,XY
*VGET,EVAL(1,8),ELEM,1,ETAB,GXY
ETABLE,SZZ,S,Z
*VGET,EVAL(1,9),ELEM,1,ETAB,SZZ
ETABLE,ENER,SENE,
*VGET,EVAL(1,10),ELEM,1,ETAB,ENER
ETABLE,EVOL,VOLU,
*VGET,EVAL(1,11),ELEM,1,ETAB,EVOL
*CFOPEN,fields,csv
*VWRITE,EIDS(1),EVAL(1,1),EVAL(1,2),EVAL(1,3),EVAL(1,4),EVAL(1,5),EVAL(1,6),EVAL(1,7),EVAL(1,8),EVAL(1,9),EVAL(1,10),EVAL(1,11)
(F12.0,11(',',E24.16))
*CFCLOS
*DEL,EVAL
*DIM,ECON,ARRAY,1024,4
*VGET,ECON(1,1),ELEM,1,NODE,1
*VGET,ECON(1,2),ELEM,1,NODE,2
*VGET,ECON(1,3),ELEM,1,NODE,3
*VGET,ECON(1,4),ELEM,1,NODE,4
*CFOPEN,connectivity,csv
*VWRITE,EIDS(1),ECON(1,1),ECON(1,2),ECON(1,3),ECON(1,4)
(F12.0,4(',',F12.0))
*CFCLOS
*DEL,EIDS
*DEL,ECON
*CFOPEN,native_counts,csv
*VWRITE,NSETS,NNAT,ENAT
(3(F16.0,','))
*CFCLOS
FINISH
/EXIT,NOSAVE
