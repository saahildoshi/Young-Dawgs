/BATCH
/CLEAR,START
RESUME,'C:/Users/sd22446/AppData/Local/Packages/OpenAI.Codex_2p2nqsd0c76g0/LocalCache/Local/YoungDawgs/artifacts/solver/v063/contact_setup_002/contact_model',db
/FILNAME,compression
/PREP7
/GOPR
KEYOPT,3,2,1
KEYOPT,3,4,2
KEYOPT,3,10,1
RMODIF,2,3,100
RMODIF,3,3,100
ESEL,S,TYPE,,1
GCGEN,NEW,42,0,PART,SELECT
GCGEN,SELECT
CM,INTERNAL_GC,ELEM
ALLSEL,ALL
R,100,,,100,-1e-5
GCDEF,SYMM,ALL,SELF,1,100
/OUTPUT,gc_definition,txt
GCDEF,LIST
ETLIST,ALL
RLIST,100
MPLIST,ALL
DLIST,ALL
/OUTPUT
*GET,NN,NODE,0,COUNT
*GET,NE,ELEM,0,COUNT
CMSEL,S,INTERNAL_GC
*GET,NGC,ELEM,0,COUNT
*CFOPEN,gc_inventory,csv
*VWRITE
('model_nodes,model_elements,general_contact_skins')
*VWRITE,NN,NE,NGC
(F16.0,2(',',F16.0))
*CFCLOS
*CFOPEN,gc_topology,csv
*VWRITE
('element,i_node,j_node,midside_node')
EID=0
*DO,KK,1,NGC
EID=ELNEXT(EID)
*GET,NI,ELEM,EID,NODE,1
*GET,NJ,ELEM,EID,NODE,2
*GET,NM,ELEM,EID,NODE,3
*VWRITE,EID,NI,NJ,NM
(F12.0,3(',',F12.0))
*ENDDO
*CFCLOS
ALLSEL,ALL
FINISH
SAVE,contact_model_gc,db,,MODEL
/EXIT,NOSAVE
