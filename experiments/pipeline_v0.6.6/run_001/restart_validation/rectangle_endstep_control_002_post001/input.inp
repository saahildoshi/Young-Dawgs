/BATCH
/CLEAR,START
RESUME,'C:/Users/sd22446/AppData/Local/Packages/OpenAI.Codex_2p2nqsd0c76g0/LocalCache/Local/YoungDawgs/artifacts/solver/v066/rectangle_endstep_control_002/checkpoint',db
/FILNAME,compression
/FILNAME,readonly
/GOPR
/POST1
FILE,'C:/Users/sd22446/AppData/Local/Packages/OpenAI.Codex_2p2nqsd0c76g0/LocalCache/Local/YoungDawgs/artifacts/solver/v066/rectangle_endstep_control_002/compression',rst
/OUTPUT,result_sets,txt
SET,LIST
/OUTPUT
/POST1
FILE,'C:/Users/sd22446/AppData/Local/Packages/OpenAI.Codex_2p2nqsd0c76g0/LocalCache/Local/YoungDawgs/artifacts/solver/v066/rectangle_endstep_control_002/compression',rst
ALLSEL,ALL
SET,1,3
*GET,TNOW,ACTIVE,0,SET,TIME
*GET,LSV,ACTIVE,0,SET,LSTP
*GET,SSV,ACTIVE,0,SET,SBST
*GET,UYTOP,NODE,623,U,Y
*GET,RFTOP,NODE,623,RF,FY
*GET,RFBOT,NODE,620,RF,FY
*CFOPEN,stage001_history,csv
*VWRITE
('pseudo_time,load_step,substep,top_uy_mm,upper_rf_y_N,lower_rf_y_N')
*VWRITE,TNOW,LSV,SSV,UYTOP,RFTOP,RFBOT
(E24.16,2(',',F10.0),3(',',E24.16))
*CFCLOS
FAILG=0
*IF,LSV,NE,1,THEN
FAILG=1
*ENDIF
*IF,SSV,NE,3,THEN
FAILG=1
*ENDIF
*IF,ABS(UYTOP+(10.24)*TNOW),GT,1e-8,THEN
FAILG=1
*ENDIF
*IF,RFTOP,GE,-1e-8,THEN
FAILG=1
*ENDIF
*IF,RFBOT,LE,1e-8,THEN
FAILG=1
*ENDIF
BAL=ABS(RFTOP+RFBOT)/MAX(ABS(RFTOP),ABS(RFBOT),1e-12)
*IF,BAL,GT,0.01,THEN
FAILG=1
*ENDIF
*CFOPEN,stage001_contact,csv
*VWRITE
('pair,element,status,pressure_i_MPa,pressure_j_MPa,gap_i_mm,gap_j_mm,contact_force_y_N')
*DO,PAIR,1,2
*IF,PAIR,EQ,1,THEN
CMSEL,S,BOTTOM_CONTACT
EXPECT=RFBOT
*ELSE
CMSEL,S,TOP_CONTACT
EXPECT=RFTOP
*ENDIF
*GET,NC,ELEM,0,COUNT
EID=0
FYTOTAL=0
CLOSED=0
MAXPEN=0
MAXPRES=0
*DO,KK,1,NC
EID=ELNEXT(EID)
*GET,STV,ELEM,EID,NMISC,19
*GET,PI,ELEM,EID,SMISC,1
*GET,PJ,ELEM,EID,SMISC,2
*GET,GI,ELEM,EID,NMISC,5
*GET,GJ,ELEM,EID,NMISC,6
*GET,FYV,ELEM,EID,NMISC,22
FYTOTAL=FYTOTAL+FYV
MAXPEN=MAX(MAXPEN,GI,GJ)
MAXPRES=MAX(MAXPRES,PI,PJ)
*IF,STV,GE,2,THEN
CLOSED=CLOSED+1
*ENDIF
*VWRITE,PAIR,EID,STV,PI,PJ,GI,GJ,FYV
(F4.0,',',F12.0,',',F4.0,5(',',E16.8))
*ENDDO
*IF,CLOSED,LT,1,THEN
FAILG=1
*ENDIF
*IF,MAXPRES,LE,0,THEN
FAILG=1
*ENDIF
*IF,MAXPEN,GT,1e-5,THEN
FAILG=1
*ENDIF
CBAL=ABS(FYTOTAL+EXPECT)/MAX(ABS(EXPECT),1e-12)
*IF,CBAL,GT,0.01,THEN
FAILG=1
*ENDIF
ALLSEL,ALL
*ENDDO
*CFCLOS
*CFOPEN,stage001_gate,txt
*VWRITE,FAILG,BAL
(F4.0,',',E24.16)
*CFCLOS
ALLSEL,ALL
*DIM,IDS,ARRAY,128
*DIM,UXV,ARRAY,128
*DIM,UYV,ARRAY,128
*CFOPEN,stage001_displacements,csv
*VWRITE
('node,ux_mm,uy_mm')
*DO,IBEG,1,617,128
NLEN=MIN(128,617-IBEG+1)
*VLEN,NLEN
*VFILL,IDS(1),RAMP,IBEG,1
*VLEN,NLEN
*VGET,UXV(1),NODE,IBEG,U,X
*VLEN,NLEN
*VGET,UYV(1),NODE,IBEG,U,Y
*VLEN,NLEN
*VWRITE,IDS(1),UXV(1),UYV(1)
(F12.0,2(',',E24.16))
*ENDDO
*CFCLOS
*DEL,IDS
*DEL,UXV
*DEL,UYV
*DIM,IDS,ARRAY,128
*DIM,MASKV,ARRAY,128
*DIM,SYV,ARRAY,128
*DIM,SEQV,ARRAY,128
*DIM,EYV,ARRAY,128
*DIM,EXV,ARRAY,128
*CFOPEN,stage001_stress,csv
*VWRITE
('node,syy_MPa,seqv_MPa,elastic_eyy,elastic_exx')
ESEL,S,TYPE,,1
CMSEL,S,CORNERS
*DO,IBEG,1,617,128
NLEN=MIN(128,617-IBEG+1)
*VLEN,NLEN
*VFILL,IDS(1),RAMP,IBEG,1
*VLEN,NLEN
*VGET,MASKV(1),NODE,IBEG,NSEL
*VLEN,NLEN
*VMASK,MASKV(1)
*VGET,SYV(1),NODE,IBEG,S,Y
*VLEN,NLEN
*VMASK,MASKV(1)
*VGET,SEQV(1),NODE,IBEG,S,EQV
*VLEN,NLEN
*VMASK,MASKV(1)
*VGET,EYV(1),NODE,IBEG,EPEL,Y
*VLEN,NLEN
*VMASK,MASKV(1)
*VGET,EXV(1),NODE,IBEG,EPEL,X
*VLEN,NLEN
*VMASK,MASKV(1)
*VWRITE,IDS(1),SYV(1),SEQV(1),EYV(1),EXV(1)
(F12.0,4(',',E24.16))
*ENDDO
*CFCLOS
ALLSEL,ALL
*DEL,IDS
*DEL,MASKV
*DEL,SYV
*DEL,SEQV
*DEL,EYV
*DEL,EXV
*IF,FAILG,NE,0,THEN
/COM,PILOT_STAGE_GATE_FAILED_NO_ADVANCEMENT
FINISH
/COM,UNQUALIFIED_STATE_EXPORTED_FOR_DIAGNOSTICS
/COM,UNQUALIFIED_STATE_EXPORTED_FOR_DIAGNOSTICS
*ENDIF
FINISH
/POST1
FILE,'C:/Users/sd22446/AppData/Local/Packages/OpenAI.Codex_2p2nqsd0c76g0/LocalCache/Local/YoungDawgs/artifacts/solver/v066/rectangle_endstep_control_002/compression',rst
ALLSEL,ALL
SET,2,12
*GET,TNOW,ACTIVE,0,SET,TIME
*GET,LSV,ACTIVE,0,SET,LSTP
*GET,SSV,ACTIVE,0,SET,SBST
