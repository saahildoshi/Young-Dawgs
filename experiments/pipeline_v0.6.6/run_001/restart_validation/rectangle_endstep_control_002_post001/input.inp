*DO,PAIR,1,2
*IF,PAIR,EQ,1,THEN
CMSEL,S,BOTTOM_CONTACT
EXPECT=RFBOT
*ELSE
CMSEL,S,TOP_CONTACT
EXPECT=RFTOP
*ENDIF
*GET,NC,ELEM,0,COUNT
EID=0
FYTOTAL=0
CLOSED=0
MAXPEN=0
MAXPRES=0
*DO,KK,1,NC
EID=ELNEXT(EID)
*GET,STV,ELEM,EID,NMISC,19
*GET,PI,ELEM,EID,SMISC,1
*GET,PJ,ELEM,EID,SMISC,2
*GET,GI,ELEM,EID,NMISC,5
*GET,GJ,ELEM,EID,NMISC,6
*GET,FYV,ELEM,EID,NMISC,22
FYTOTAL=FYTOTAL+FYV
MAXPEN=MAX(MAXPEN,GI,GJ)
MAXPRES=MAX(MAXPRES,PI,PJ)
*IF,STV,GE,2,THEN
CLOSED=CLOSED+1
*ENDIF
*VWRITE,PAIR,EID,STV,PI,PJ,GI,GJ,FYV
(F4.0,',',F12.0,',',F4.0,5(',',E16.8))
*ENDDO
*IF,CLOSED,LT,1,THEN
FAILG=1
*ENDIF
*IF,MAXPRES,LE,0,THEN
FAILG=1
*ENDIF
*IF,MAXPEN,GT,1e-5,THEN
FAILG=1
*ENDIF
CBAL=ABS(FYTOTAL+EXPECT)/MAX(ABS(EXPECT),1e-12)
*IF,CBAL,GT,0.01,THEN
FAILG=1
*ENDIF
ALLSEL,ALL
*ENDDO
*CFCLOS
*CFOPEN,stage002_gate,txt
*VWRITE,FAILG,BAL
(F4.0,',',E24.16)
*CFCLOS
ALLSEL,ALL
*DIM,IDS,ARRAY,128
*DIM,UXV,ARRAY,128
*DIM,UYV,ARRAY,128
*CFOPEN,stage002_displacements,csv
*VWRITE
('node,ux_mm,uy_mm')
*DO,IBEG,1,617,128
NLEN=MIN(128,617-IBEG+1)
*VLEN,NLEN
*VFILL,IDS(1),RAMP,IBEG,1
*VLEN,NLEN
*VGET,UXV(1),NODE,IBEG,U,X
*VLEN,NLEN
*VGET,UYV(1),NODE,IBEG,U,Y
*VLEN,NLEN
*VWRITE,IDS(1),UXV(1),UYV(1)
(F12.0,2(',',E24.16))
*ENDDO
*CFCLOS
*DEL,IDS
*DEL,UXV
*DEL,UYV
*DIM,IDS,ARRAY,128
*DIM,MASKV,ARRAY,128
*DIM,SYV,ARRAY,128
*DIM,SEQV,ARRAY,128
*DIM,EYV,ARRAY,128
*DIM,EXV,ARRAY,128
*CFOPEN,stage002_stress,csv
*VWRITE
('node,syy_MPa,seqv_MPa,elastic_eyy,elastic_exx')
ESEL,S,TYPE,,1
CMSEL,S,CORNERS
*DO,IBEG,1,617,128
NLEN=MIN(128,617-IBEG+1)
*VLEN,NLEN
*VFILL,IDS(1),RAMP,IBEG,1
*VLEN,NLEN
*VGET,MASKV(1),NODE,IBEG,NSEL
*VLEN,NLEN
*VMASK,MASKV(1)
*VGET,SYV(1),NODE,IBEG,S,Y
*VLEN,NLEN
*VMASK,MASKV(1)
*VGET,SEQV(1),NODE,IBEG,S,EQV
*VLEN,NLEN
*VMASK,MASKV(1)
*VGET,EYV(1),NODE,IBEG,EPEL,Y
*VLEN,NLEN
*VMASK,MASKV(1)
*VGET,EXV(1),NODE,IBEG,EPEL,X
*VLEN,NLEN
*VMASK,MASKV(1)
*VWRITE,IDS(1),SYV(1),SEQV(1),EYV(1),EXV(1)
(F12.0,4(',',E24.16))
*ENDDO
*CFCLOS
ALLSEL,ALL
*DEL,IDS
*DEL,MASKV
*DEL,SYV
*DEL,SEQV
*DEL,EYV
*DEL,EXV
*IF,FAILG,NE,0,THEN
/COM,PILOT_STAGE_GATE_FAILED_NO_ADVANCEMENT
FINISH
/COM,UNQUALIFIED_STATE_EXPORTED_FOR_DIAGNOSTICS
/COM,UNQUALIFIED_STATE_EXPORTED_FOR_DIAGNOSTICS
