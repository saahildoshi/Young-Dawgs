FILE,'C:/Users/sd22446/AppData/Local/Packages/OpenAI.Codex_2p2nqsd0c76g0/LocalCache/Local/YoungDawgs/artifacts/solver/v066/fine_nodal_recovery01_001/compression',rst
ALLSEL,ALL
SET,3,1
*GET,TNOW,ACTIVE,0,SET,TIME
*GET,LSV,ACTIVE,0,SET,LSTP
*GET,SSV,ACTIVE,0,SET,SBST
*GET,UYTOP,NODE,2766511,U,Y
*GET,RFTOP,NODE,2766511,RF,FY
*GET,RFBOT,NODE,2766508,RF,FY
*CFOPEN,stage001_history,csv
*VWRITE
('pseudo_time,load_step,substep,top_uy_mm,upper_rf_y_N,lower_rf_y_N')
*VWRITE,TNOW,LSV,SSV,UYTOP,RFTOP,RFBOT
(E24.16,2(',',F10.0),3(',',E24.16))
*CFCLOS
FAILG=0
*IF,LSV,NE,3,THEN
FAILG=1
*ENDIF
*IF,SSV,NE,1,THEN
FAILG=1
*ENDIF
*IF,ABS(UYTOP+(10.24)*TNOW),GT,1e-8,THEN
FAILG=1
*ENDIF
*IF,RFTOP,GE,-1e-8,THEN
FAILG=1
*ENDIF
*IF,RFBOT,LE,1e-8,THEN
FAILG=1
*ENDIF
BAL=ABS(RFTOP+RFBOT)/MAX(ABS(RFTOP),ABS(RFBOT),1e-12)
*IF,BAL,GT,0.01,THEN
FAILG=1
*ENDIF
ESEL,S,ENAME,,172
ETABLE,ERAS
ETABLE,CNSTAT,NMISC,19
ALLSEL,ALL
*CFOPEN,stage001_contact_status,csv
*VWRITE
('pair,element,status')
*DO,PAIR,1,2
*IF,PAIR,EQ,1,THEN
CMSEL,S,BOTTOM_CONTACT
*ELSE
CMSEL,S,TOP_CONTACT
*ENDIF
*GET,NC,ELEM,0,COUNT
EID=0
*DO,KK,1,NC
EID=ELNEXT(EID)
*GET,CSTATV,ELEM,EID,ETAB,CNSTAT
*VWRITE,PAIR,EID,CSTATV
(F4.0,',',F12.0,',',F4.0)
*ENDDO
ALLSEL,ALL
*ENDDO
*CFCLOS
*CFOPEN,stage001_contact,csv
*VWRITE
('pair,element,status,pressure_i_MPa,pressure_j_MPa,gap_i_mm,gap_j_mm,contact_force_y_N')
*DO,PAIR,1,2
*IF,PAIR,EQ,1,THEN
CMSEL,S,BOTTOM_CONTACT
EXPECT=RFBOT
*ELSE
CMSEL,S,TOP_CONTACT
EXPECT=RFTOP
*ENDIF
*GET,NC,ELEM,0,COUNT
EID=0
FYTOTAL=0
CLOSED=0
MAXPEN=0
MAXPRES=0
*DO,KK,1,NC
EID=ELNEXT(EID)
*GET,STV,ELEM,EID,ETAB,CNSTAT
*IF,STV,GT,0,THEN
*GET,PI,ELEM,EID,SMISC,1
*GET,PJ,ELEM,EID,SMISC,2
*GET,GI,ELEM,EID,NMISC,5
*GET,GJ,ELEM,EID,NMISC,6
*GET,FYV,ELEM,EID,NMISC,22
FYTOTAL=FYTOTAL+FYV
MAXPEN=MAX(MAXPEN,GI,GJ)
MAXPRES=MAX(MAXPRES,PI,PJ)
*IF,STV,GE,2,THEN
CLOSED=CLOSED+1
*ENDIF
*VWRITE,PAIR,EID,STV,PI,PJ,GI,GJ,FYV
(F4.0,',',F12.0,',',F4.0,5(',',E16.8))
*ENDIF
*ENDDO
*IF,CLOSED,LT,1,THEN
FAILG=1
*ENDIF
*IF,MAXPRES,LE,0,THEN
FAILG=1
*ENDIF
*IF,MAXPEN,GT,1e-5,THEN
FAILG=1
*ENDIF
CBAL=ABS(FYTOTAL+EXPECT)/MAX(ABS(EXPECT),1e-12)
*IF,CBAL,GT,0.01,THEN
FAILG=1
*ENDIF
ALLSEL,ALL
*ENDDO
*CFCLOS
*CFOPEN,stage001_gate,txt
*VWRITE,FAILG,BAL
(F4.0,',',E24.16)
*CFCLOS
ALLSEL,ALL
